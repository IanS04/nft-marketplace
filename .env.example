# Base da API REST (interceptada pelo MSW quando os mocks estão ligados)
VITE_API_URL=/api
# Vazio = mesma origem (o binding do MSW intercepta o Socket.IO)
VITE_SOCKET_URL=
# Liga o MSW (dev, demo publicada, Playwright e Lighthouse)
VITE_ENABLE_MOCKS=true
# Cenário inicial; ?scenario= na URL tem prioridade
VITE_MOCK_SCENARIO=default
